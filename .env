# Meta / Facebook App
META_VERIFY_TOKEN=your_secure_verify_token_here
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback

# Data stores
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentiment_db
# Use redis://localhost:6379 if you already have Redis on 6379; use 6380 when using compose below
REDIS_URL=redis://localhost:6380/0
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=sentiment_platform

# Optional: Llama inference service (ai_pipeline/inference_server.py)
INFERENCE_URL=http://localhost:8001/analyze

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
