# SentinelAI Production Environment Variables
# Copy this file to .env and fill in all values before deploying

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=sentiment_db

# ─── Redis (optional password for production) ────────────────────────────────
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32

# ─── Meta / Facebook Webhook ─────────────────────────────────────────────────
META_VERIFY_TOKEN=CHANGE_ME_YOUR_SECURE_VERIFY_TOKEN
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# ─── CORS (set to your actual domain after deployment) ──────────────────────
CORS_ORIGINS=https://your-domain.com

# ─── AI Inference Mode ───────────────────────────────────────────────────────
# Options: heuristic (default, no deps) | roberta | llama
INFERENCE_MODE=heuristic
# INFERENCE_URL=http://localhost:8001/analyze  # only for llama mode

# ─── Stripe (SaaS billing - optional) ────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# FRONTEND_URL=https://your-domain.com
