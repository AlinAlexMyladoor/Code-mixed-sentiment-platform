# SentinelAI Production Environment Variables
# Copy this file to .env and fill in all values before deploying

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=sentiment_db

# ─── Redis (optional password for production) ────────────────────────────────
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32

# ─── Meta / Facebook Webhook ─────────────────────────────────────────────────
META_VERIFY_TOKEN=CHANGE_ME_YOUR_SECURE_VERIFY_TOKEN
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# ─── CORS (set to your actual domain after deployment) ──────────────────────
CORS_ORIGINS=https://your-domain.com

# ─── AI Inference Mode ───────────────────────────────────────────────────────
# Controls which sentiment analysis engine is active.
#
# ┌─────────────┬─────────────────────────────────────────────────────────────┐
# │ Mode        │ Description                                                 │
# ├─────────────┼─────────────────────────────────────────────────────────────┤
# │ heuristic   │ DEFAULT. Fast rule-based engine. Zero GPU deps. Ships now.  │
# │ roberta     │ CardiffNLP RoBERTa on CPU (~400 MB). Higher accuracy.       │
# │ llama       │ Fine-tuned Llama 3 8B LoRA (GPU required). Best accuracy.  │
# └─────────────┴─────────────────────────────────────────────────────────────┘
INFERENCE_MODE=heuristic

# ─── Llama 3 Upgrade — NEXT SPRINT ACTIVATION GUIDE ─────────────────────────
# When ready to switch from heuristics to the fine-tuned Llama 3 model:
#
# Step 1 — Train or download the LoRA adapter:
#   cd ai_pipeline && python train_lora.py
#   (or copy pre-trained adapter to ./ai_pipeline/llama3-code-mixed-lora/)
#
# Step 2 — Start the GPU inference server:
#   python ai_pipeline/inference_server.py --model ./ai_pipeline/llama3-code-mixed-lora
#   (Requires CUDA GPU with ≥16 GB VRAM for 4-bit quantized Llama 3 8B)
#
# Step 3 — Set these two env vars (uncomment below):
# INFERENCE_MODE=llama
# INFERENCE_URL=http://localhost:8001/analyze
#
# Step 4 — Verify the switch:
#   curl http://localhost:8000/api/inference/status
#   → Should return: {"inference_mode": "llama", "llama_server": "healthy"}
#
# For Docker production deployment, also uncomment the `gpu-inference` service
# in docker-compose.prod.yml and rebuild: docker-compose up --build gpu-inference

# ─── Stripe (SaaS billing - optional) ────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# FRONTEND_URL=https://your-domain.com
